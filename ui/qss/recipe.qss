/* ============================================================
   BLUE SQUARE — Recipe Page Styles
   ============================================================ */

QWidget#recipe_page {
    background-color: #252526;
}

QLabel#page_title {
    font-size: 20px;
    font-weight: 800;
    color: #007acc;
    letter-spacing: 1px;
}

QFrame#recipe_form {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    padding: 16px;
}

QLabel#form_label {
    font-size: 12px;
    color: #808080;
    font-weight: 600;
}

QLineEdit#recipe_input {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 13px;
}

QLineEdit#recipe_input:focus {
    border-color: #007acc;
}

QLineEdit#recipe_input:disabled {
    background-color: #1e1e1e;
    color: #808080;
}

QFrame#active_recipe_panel {
    background-color: #2d2d30;
    border: 2px solid #007acc;
    border-radius: 8px;
    padding: 16px;
}

QLabel#active_recipe_title {
    font-size: 16px;
    font-weight: 700;
    color: #007acc;
}

QLabel#active_recipe_value {
    font-size: 13px;
    color: #ffffff;
}

QFrame#action_bar {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    padding: 8px;
}

QPushButton#start_btn {
    background-color: #007acc;
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    padding: 10px 30px;
    min-height: 32px;
}

QPushButton#start_btn:hover {
    background-color: #0062a3;
}

QPushButton#export_btn {
    background-color: #333333;
    color: #cccccc;
    font-weight: 700;
    border: 1px solid #458b53;
    border-radius: 4px;
    padding: 8px 20px;
}

QPushButton#export_btn:hover {
    background-color: #458b53;
    color: #ffffff;
}

QPushButton#success_button {
    background-color: #007acc;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 700;
}
QPushButton#success_button:hover {
    background-color: #0062a3;
}